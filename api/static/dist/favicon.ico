<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#312e81" />
    </linearGradient>
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#4f46e5" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Base Rounded Squircle -->
  <rect x="4" y="4" width="120" height="120" rx="28" fill="url(#bgGrad)" stroke="#4338ca" stroke-width="2.5" />

  <!-- Shield Base -->
  <path d="M64 20 L96 34 V66 C96 86 64 104 64 104 C64 104 32 86 32 66 V34 Z" 
        fill="url(#shieldGrad)" opacity="0.25" />
  <path d="M64 24 L92 36 V64 C92 82 64 98 64 98 C64 98 36 82 36 64 V36 Z" 
        fill="none" stroke="#818cf8" stroke-width="3" stroke-linejoin="round" />

  <!-- WiFi Waves -->
  <!-- Outer wave -->
  <path d="M46 50 A 24 24 0 0 1 82 50" fill="none" stroke="#a5b4fc" stroke-width="4" stroke-linecap="round" />
  <!-- Middle wave -->
  <path d="M52 60 A 16 16 0 0 1 76 60" fill="none" stroke="#c7d2fe" stroke-width="4" stroke-linecap="round" />
  <!-- Center Signal Dot / Key Badge -->
  <circle cx="64" cy="72" r="5" fill="url(#accentGrad)" filter="url(#glow)" />
  <path d="M64 77 V83 M61 80 H67" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" />

  <!-- Subtle Corner Security Node -->
  <circle cx="98" cy="30" r="4" fill="#34d399" filter="url(#glow)" />
</svg>
