#!/bin/bash
set -e

echo "🔍 [pre-commit] 1/3 Running Frontend ESLint (no-undef & syntax)..."
cd "$(git rev-parse --show-toplevel)/frontend"
npm run lint

echo "⚡ [pre-commit] 2/3 Running Vite Production Build..."
npm run build

echo "🐍 [pre-commit] 3/3 Checking Python compilation..."
cd "$(git rev-parse --show-toplevel)"
python3 -m py_compile api/*.py

echo "✅ [pre-commit] All pre-commit checks passed!"
