server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        ipaddr = *
        port = 1813
        type = acct
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        type = auth
        ipv6addr = ::
        port = 1812
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        ipv6addr = ::
        port = 1813
        type = acct
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    authorize {
        preprocess
        chap
        mschap
        digest
        suffix
        eap {
            ok = return
        }
        files
        -sql
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        mschap
        digest
        eap
    }

    preacct {
        preprocess
        acct_unique
        suffix
        files
    }

    accounting {
        detail
        -sql
        exec
        attr_filter.accounting_response
    }

    session {
        -sql
    }

    post-auth {
        # Verified-device lockdown (API-managed user_device_policy /
        # verified_devices tables; Admin Console > Users > MAC lock).
        # Default OFF: users without a policy row, and unknown users, pass
        # through untouched. Placed here (not authorize) so it also covers
        # EAP (which returns early from authorize) with the final User-Name.
        # Rejects here jump to Post-Auth-Type REJECT below, whose -sql logs
        # the Reply-Message into radpostauth.reason for the Auth History view.
        if (&User-Name && "%{sql:SELECT CASE WHEN require_verified THEN 'yes' ELSE 'no' END FROM user_device_policy WHERE username='%{User-Name}'}" == 'yes') {
            if (!&Calling-Station-Id || "%{sql:SELECT COUNT(*) FROM verified_devices WHERE username='%{User-Name}' AND mac=REPLACE(REPLACE(REPLACE(REPLACE(UPPER('%{Calling-Station-Id}'), ':', ''), '-', ''), ' ', ''), '.', '')}" == '0') {
                update reply {
                    Reply-Message := "Rejected: device MAC not verified for this user. Ask the admin to verify your device, or test your login at https://wifi.rajlabs.in"
                }
                reject
            }
        }
        update control {
            RajLabs-PostAuth-Logged := 'no'
        }
        Post-Auth-Type REJECT {
            # Every reject leaves a human-readable reason in radpostauth.reason.
            # Specific policies (device lockdown, subscription sync) already set
            # Reply-Message; the fallbacks below cover the rest. The captive
            # portal URL doubles as the "redirect on failure": 802.1X has no
            # HTTP redirect, so the rejection itself tells the user where to
            # test their password and recharge (supplicants that display
            # Reply-Message show it; the dashboard Tester shows it always).
            if (&User-Name =~ /^anonymous$/i) {
                if (!&reply:Reply-Message) {
                    update reply {
                        Reply-Message := "Rejected: phone hid the real username inside the encrypted tunnel (outer identity 'anonymous'). Re-check the Wi-Fi password, or test your login and recharge at https://wifi.rajlabs.in"
                    }
                }
            }
            elsif (!&reply:Reply-Message) {
                update reply {
                    Reply-Message := "Rejected: authentication failed (wrong password, unknown user, expired or no active subscription). Test your login and recharge at https://wifi.rajlabs.in"
                }
            }
            -sql
            update control {
                RajLabs-PostAuth-Logged := 'yes'
            }
            attr_filter.access_reject
            eap
        }
        # Exactly one radpostauth row per attempt: rejects were already logged
        # above with their reason; accepts log here.
        if (&control:RajLabs-PostAuth-Logged != 'yes') {
            -sql
        }
        exec
        remove_reply_message_if_eap
    }

    pre-proxy {
    }

    post-proxy {
        eap
    }
}
