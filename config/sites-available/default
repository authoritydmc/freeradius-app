server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        ipaddr = *
        port = 1813
        type = acct
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        type = auth
        ipv6addr = ::
        port = 1812
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        ipv6addr = ::
        port = 1813
        type = acct
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    authorize {
        preprocess
        chap
        mschap
        digest
        suffix
        eap {
            ok = return
        }
        files
        -sql
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        mschap
        digest
        eap
    }

    preacct {
        preprocess
        acct_unique
        suffix
        files
    }

    accounting {
        detail
        -sql
        exec
        attr_filter.accounting_response
    }

    session {
        -sql
    }

    post-auth {
        # Verified-device lockdown (API-managed user_device_policy /
        # verified_devices tables; Admin Console > Users > MAC lock).
        # Default OFF: users without a policy row, and unknown users, pass
        # through untouched. Placed here (not authorize) so it also covers
        # EAP (which returns early from authorize) with the final User-Name.
        # Rejects here jump to Post-Auth-Type REJECT below, whose -sql logs
        # the Reply-Message into radpostauth.reason for the Auth History view.
        # NOTE: User-Name / Calling-Station-Id are supplicant-controlled.
        # They enter SQL below only through replace(...''''...''''') which
        # doubles single quotes (same guard as postauth_query) — never add a
        # bare '%{...}' interpolation here.
        if (&User-Name && "%{sql:SELECT CASE WHEN require_verified THEN 'yes' ELSE 'no' END FROM user_device_policy WHERE username=replace('%{User-Name}', '''', '''''')}" == 'yes') {
            if (!&Calling-Station-Id || "%{sql:SELECT COUNT(*) FROM verified_devices WHERE username=replace('%{User-Name}', '''', '''''') AND mac=REPLACE(REPLACE(REPLACE(REPLACE(UPPER(replace('%{Calling-Station-Id}', '''', '''''')), ':', ''), '-', ''), ' ', ''), '.', '')}" == '0') {
                update reply {
                    Reply-Message := "Rejected: device MAC not verified for this user. Ask the admin to verify your device, or test your login at https://wifi.rajlabs.in"
                }
                reject
            }
        }
        # NOTE: the flag must be a dictionary-known attribute (Tmp-String-0);
        # custom control: names are rejected at parse time ("Unknown attribute").
        update control {
            Tmp-String-0 := 'no'
        }
        Post-Auth-Type REJECT {
            # Granular reject reason saved directly into radpostauth.reason.
            if (&User-Name =~ /^anonymous$/i) {
                if (!&reply:Reply-Message) {
                    update reply {
                        Reply-Message := "Rejected: outer identity 'anonymous' failed inner tunnel authentication. Check password at https://wifi.rajlabs.in"
                    }
                }
            }
            elsif (!&reply:Reply-Message) {
                # Determine granular reason via SQL lookups if not already set by policy
                if ("%{sql:SELECT COUNT(*) FROM radcheck WHERE username=replace('%{User-Name}', '''', '''''') AND attribute='Auth-Type' AND value='Reject'}" > '0') {
                    update reply {
                        Reply-Message := "Rejected: user account is banned or suspended by administrator."
                    }
                }
                elsif ("%{sql:SELECT COUNT(*) FROM radcheck WHERE username=replace('%{User-Name}', '''', '''''')}" == '0') {
                    update reply {
                        Reply-Message := "Rejected: unknown user %{User-Name} (not registered). Register or recharge at https://wifi.rajlabs.in"
                    }
                }
                elsif ("%{sql:SELECT COUNT(*) FROM radcheck WHERE username=replace('%{User-Name}', '''', '''''') AND attribute='Expiration' AND value != ''}" > '0') {
                    if ("%{sql:SELECT CASE WHEN TO_TIMESTAMP(value, 'DD Mon YYYY HH24:MI:SS') <= NOW() THEN 'expired' ELSE 'active' END FROM radcheck WHERE username=replace('%{User-Name}', '''', '''''') AND attribute='Expiration' LIMIT 1}" == 'expired') {
                        update reply {
                            Reply-Message := "Rejected: Wi-Fi subscription expired. Renew plan at https://wifi.rajlabs.in"
                        }
                    }
                    else {
                        update reply {
                            Reply-Message := "Rejected: invalid password for user %{User-Name}. Check credentials at https://wifi.rajlabs.in"
                        }
                    }
                }
                else {
                    update reply {
                        Reply-Message := "Rejected: invalid password for user %{User-Name}. Test login at https://wifi.rajlabs.in"
                    }
                }
            }
            -sql
            update control {
                Tmp-String-0 := 'yes'
            }
            attr_filter.access_reject
            eap
        }
        # Exactly one radpostauth row per attempt: rejects were already logged
        # above with their reason; accepts log here.
        if (&control:Tmp-String-0 != 'yes') {
            -sql
        }
        exec
        remove_reply_message_if_eap
    }

    pre-proxy {
    }

    post-proxy {
        eap
    }
}
