sql {
    dialect = "postgresql"
    driver = "rlm_sql_postgresql"

    # PostgreSQL Connection parameters
    server = "$ENV{POSTGRES_HOST}"
    port = "$ENV{POSTGRES_PORT}"
    login = "$ENV{POSTGRES_USER}"
    password = "$ENV{POSTGRES_PASSWORD}"
    radius_db = "$ENV{POSTGRES_DB}"

    # Tables configuration
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    # Read NAS clients from SQL table
    read_clients = yes
    client_table = "nas"

    # Group attribute definition
    group_attribute = "SQL-Group"

    # Connection pool configuration
    pool {
        start = ${thread[pool].start_servers}
        min = ${thread[pool].min_spare_servers}
        max = ${thread[pool].max_servers}
        spare = ${thread[pool].max_spare_servers}
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }

    # Include PostgreSQL queries configuration
    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf

    # Store the reject reason (Reply-Message set by policies such as the
    # verified-device lockdown) in radpostauth.reason for the Auth History
    # view, plus EAP/device/AP context so outer-identity ("anonymous") rows
    # stay diagnosable. Overrides the stock postauth_query from queries.conf
    # above. Columns come from migration 005 (also in config/schema.sql);
    # sections call sql as "-sql" so a missing column on old DBs is ignored,
    # never fatal.
    #
    # SECURITY: every %{...} value here is attacker-influenced (outer EAP
    # identity, MACs, AP IDs are all supplicant-controlled pre-auth), and
    # rlm_sql does not escape expansions — a single quote would break out of
    # the string (PQexec runs stacked statements). Each value goes through
    # SQL-side replace(...''''...''''') which doubles quotes: content is
    # preserved, breakout is impossible. Do NOT add bare '%{...}' values.
    postauth_query = "INSERT INTO ${postauth_table} (username, pass, reply, reason, eap_type, calling_station, called_station, authdate) VALUES (replace('%{User-Name}', '''', ''''''), '', replace('%{reply:Packet-Type}', '''', ''''''), replace('%{reply:Reply-Message}', '''', ''''''), replace('%{EAP-Type}', '''', ''''''), replace('%{Calling-Station-Id}', '''', ''''''), replace('%{Called-Station-Id}', '''', ''''''), '%S')"
}
