# ==========================================
# FreeRADIUS Enterprise AAA Environment Configuration
# ==========================================

# PostgreSQL Connection
POSTGRES_HOST=dev-postgres
POSTGRES_PORT=5432
POSTGRES_DB=radius
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# RADIUS Shared Secret (Configured on MikroTik / OpenWrt / Access Points)
RADIUS_SECRET=YourStrongRadiusSharedSecret_123!

# Administrator Credentials (for Dashboard & API access)
# REQUIRED: the container refuses to boot on missing/published-default values.
# Generate strong ones with: openssl rand -hex 32
RADIUS_ADMIN_USER=admin
RADIUS_ADMIN_PASSWORD=change_me_to_a_strong_unique_password
SESSION_SECRET=change_me_to_at_least_32_random_chars__openssl_rand_hex_32

# Local CA private-key password (set by FreeRADIUS `certs/bootstrap`).
# Only needed if you re-bootstrap the CA with a custom password.
CA_KEY_PASSWORD=whatever

# API and Web UI Port
RADIUS_API_PORT=8090

# Server log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Central Rajlabs-CA Cert Signer (optional, env-based — no hardcoded URLs).
# When set, client certificates are signed remotely; otherwise local CA is used.
# Admin Console → EAP-TLS tab shows live connectivity + API-key validity.
CERT_SIGNER_API_URL=https://backend.rajlabs.in/cert-signer
CERT_SIGNER_API_KEY=your_signer_api_key_here

# Public RADIUS host shown in UI/docs (UDP endpoint routers point at).
# Leave empty to auto-use the API request host.
RADIUS_PUBLIC_HOST=

# Browser transport (see README: Rate limits, CORS & cookies)
# CORS_ORIGINS=comma-separated dashboard origins; empty = same-origin only
CORS_ORIGINS=
# COOKIE_SECURE=0 only for plain-HTTP LAN testing (browsers drop Secure cookies over HTTP)
COOKIE_SECURE=1

# Rate limits per IP per minute (0 = off)
RL_LOGIN_PER_MIN=10
RL_ENROLL_PER_MIN=5
RL_TEST_AUTH_PER_MIN=20
RL_CERT_ISSUE_PER_MIN=10

# Table retention in days, purged at startup (0 = keep forever)
AUDIT_RETENTION_DAYS=365
ACCOUNTING_RETENTION_DAYS=365

# Runtime tuning
UVICORN_WORKERS=1
BOOTSTRAP_STRICT=0
