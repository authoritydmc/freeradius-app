# ==========================================
# FreeRADIUS Enterprise AAA Environment Configuration
# ==========================================

# PostgreSQL Connection
POSTGRES_HOST=dev-postgres
POSTGRES_PORT=5432
POSTGRES_DB=radius
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# RADIUS Shared Secret (Configured on MikroTik / OpenWrt / Access Points)
RADIUS_SECRET=YourStrongRadiusSharedSecret_123!

# Administrator Credentials (for Dashboard & API access)
RADIUS_ADMIN_USER=admin
RADIUS_ADMIN_PASSWORD=YourStrongAdminPassword_123!
SESSION_SECRET=YourRandomSecretKeyForSigningSessions_32_Chars

# API and Web UI Port
RADIUS_API_PORT=8090

# Server log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Central Rajlabs-CA Cert Signer (optional, env-based — no hardcoded URLs).
# When set, client certificates are signed remotely; otherwise local CA is used.
# Admin Console → EAP-TLS tab shows live connectivity + API-key validity.
CERT_SIGNER_API_URL=https://backend.rajlabs.in/cert-signer
CERT_SIGNER_API_KEY=your_signer_api_key_here

# Public RADIUS host shown in UI/docs (UDP endpoint routers point at).
# Leave empty to auto-use the API request host.
RADIUS_PUBLIC_HOST=
